/* SiteForms service worker – offline cache */
const C = 'siteforms-v21';
const ASSETS = ['./', 'index.html', 'app.css', 'manifest.webmanifest', 'icon.svg', 'icon-192.png', 'icon-512.png', 'util.js', 'sync-config.js', 'auth.js', 'graph.js', 'parser.js', 'formula.js', 'render.js', 'sig.js', 'attach.js', 'export.js', 'share.js', 'autosave.js', 'sync.js', 'pdf-lib.min.js', 'app.js', 'exceljs.min.js', 'jspdf.umd.min.js', 'html2canvas.min.js', 'Duck_Bank_Release_.xlsx', 'DOT_Pre_Trip_Inspection_Checklist_with_Photo_Log.xlsx'];
self.addEventListener('install', (e) => { e.waitUntil(caches.open(C).then((c) => c.addAll(ASSETS)).then(() => self.skipWaiting())); });
self.addEventListener('activate', (e) => { e.waitUntil(caches.keys().then((ks) => Promise.all(ks.filter((k) => k !== C).map((k) => caches.delete(k)))).then(() => self.clients.claim())); });
self.addEventListener('fetch', (e) => {
  if (e.request.method !== 'GET') return;
  e.respondWith(fetch(e.request).then((r) => { const cp = r.clone(); caches.open(C).then((c) => c.put(e.request, cp)); return r; }).catch(() => caches.match(e.request, { ignoreSearch: true })));
});
